cabal-version:      3.0
name:               keynub-samples
version:            1.1.1
synopsis:           The KeyNub SDK's Haskell samples
license:            Apache-2.0
build-type:         Simple

-- cabal.project points at the binding two directories up:
--
--   cabal run verify_and_read
--   cabal run rotate_write_key -- ../../keys/keynub-shipping-writeauth.key.der my-key.der

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >= 4.14 && < 5,
                    bytestring,
                    keynub-licdongle

executable verify_and_read
  import:           shared
  hs-source-dirs:   app
  main-is:          VerifyAndRead.hs

executable rotate_write_key
  import:           shared
  hs-source-dirs:   app
  main-is:          RotateWriteKey.hs
