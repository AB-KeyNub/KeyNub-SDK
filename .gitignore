dub.selections.json
bindings/d/build/
samples/d/verify_and_read
samples/d/rotate_write_key

# --- the tracked prebuilt libraries ------------------------------------------
# Last word, deliberately: these are the one binary thing this repository does
# track, and a broad pattern above must not be able to drop them.
!natives/
!natives/**
