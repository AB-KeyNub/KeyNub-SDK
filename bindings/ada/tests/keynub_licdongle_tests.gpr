--  The crate's test program. Built by tests/run.sh with the crate's own
--  configuration (alr build in the crate folder first, then this project).
with "../keynub_licdongle.gpr";

project Keynub_Licdongle_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("test_stub.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-gnata", "-g");
   end Compiler;

   package Binder is
      --  -static: the GNAT runtime linked in, so the executable carries no
      --  run path to the toolchain (macOS refuses a duplicate LC_RPATH).
      for Switches ("Ada") use ("-Es", "-static");
   end Binder;
end Keynub_Licdongle_Tests;
