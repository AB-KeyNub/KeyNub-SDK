Notebook[{Cell[CellGroupData[{Cell["LicDongleEraseRecord", "ObjectName", 
      CellID -> 956716193], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{"LicDongleEraseRecord", "[", 
            RowBox[{StyleBox["handle", "TI"], ",", StyleBox["name", "TI"]}], 
            "]"}]], "InlineFormula"], 
        " \[LineSeparator]erases the record name."}], "Usage", 
      CellID -> 1866038666], Cell["An empty name gives a Failure and erases \
nothing; LicDongleEraseAllRecords erases every record.", "Notes", 
      CellID -> 1379638495], Cell["The call needs the write role; elevate the \
session with LicDongleAuthorizeWrite.", "Notes", CellID -> 1261620583], 
     Cell["On failure the result is Failure[\"LicDongleError\", ...] with \
\"Status\" (the C status code), \"Operation\" and \"Detail\".", "Notes", 
      CellID -> 1010171381]}, Open]], 
