Notebook[{Cell[CellGroupData[{Cell["LicDongleVerifyGenuine", "ObjectName", 
      CellID -> 792505379], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{"LicDongleVerifyGenuine", "[", 
            StyleBox["handle", "TI"], "]"}]], "InlineFormula"], " \
\[LineSeparator]proves that the dongle is genuine and gives an association \
with \"Genuine\", \"Serial\" and \"ProvisionedDate\"."}], "Usage", 
      CellID -> 1822008694], Cell["The dongle proves possession of its device \
key against the certificate it carries, checked against the CA root the \
library holds; the result carries the serial from that certificate.", 
      "Notes", CellID -> 1760037382], Cell["The call needs no session.", 
      "Notes", CellID -> 1910594490], Cell["A dongle that does not prove \
genuine gives a Failure; LicDongleGenuineQ is the non-failing form.", 
      "Notes", CellID -> 115764016], Cell["On failure the result is \
Failure[\"LicDongleError\", ...] with \"Status\" (the C status code), \
\"Operation\" and \"Detail\".", "Notes", CellID -> 411238031]}, Open]], 
