Notebook[{Cell[CellGroupData[{Cell["LicDongleAppEncrypt", "ObjectName", 
      CellID -> 279374584], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{"LicDongleAppEncrypt", "[", 
            RowBox[{StyleBox["handle", "TI"], ",", StyleBox["data", "TI"], 
              ",", StyleBox["scope", "TI"]}], "]"}]], "InlineFormula"], " \
\[LineSeparator]encrypts data so that only a dongle can decrypt it, and gives \
the sealed bytes as a ByteArray."}], "Usage", CellID -> 1955690565], 
     Cell["scope is \"Developer\" (any dongle issued to the same developer \
decrypts) or \"Device\" (only this dongle decrypts).", "Notes", 
      CellID -> 959316711], Cell["data can be a ByteArray or a String; a \
String is stored as its UTF-8 bytes.", "Notes", CellID -> 539448159], 
     Cell["Sealed data is what a program can hold instead of a plain check: \
encrypted once at license-issue time, decrypted with LicDongleAppDecrypt at \
run time.", "Notes", CellID -> 1461740489], 
     Cell["The call needs a session; open one with LicDongleSessionOpen.", 
      "Notes", CellID -> 1229256302], Cell["On failure the result is \
Failure[\"LicDongleError\", ...] with \"Status\" (the C status code), \
\"Operation\" and \"Detail\".", "Notes", CellID -> 1044629248]}, Open]], 
