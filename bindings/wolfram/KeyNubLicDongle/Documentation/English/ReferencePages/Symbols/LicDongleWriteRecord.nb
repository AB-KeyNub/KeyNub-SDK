     Cell["A record that does not exist is created.", "Notes", 
      CellID -> 139946667], Cell["The call needs the write role; elevate the \
session with LicDongleAuthorizeWrite.", "Notes", CellID -> 2135972413], 
     Cell["On failure the result is Failure[\"LicDongleError\", ...] with \
\"Status\" (the C status code), \"Operation\" and \"Detail\".", "Notes", 
      CellID -> 1630850978]}, Open]], 
