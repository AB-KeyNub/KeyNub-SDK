Notebook[{Cell[CellGroupData[{Cell["KeyNub License Dongle", "GuideTitle", 
      CellID -> 2021641786], Cell["KeyNubLicDongle is the Wolfram Language \
client for the KeyNub USB license dongle: verify that a dongle is genuine, \
read and write the license records it stores, use its hardware counters, and \
encrypt data so that only a dongle can decrypt it. The paclet is pure Wolfram \
Language over the SDK's flat C API through ForeignFunctionLoad and loads the \
SDK's native library at run time.", "GuideAbstract", CellID -> 663901481]}, 
    Open]], Cell[CellGroupData[{Cell["Library", "GuideFunctionsSection", 
      CellID -> 1152572169], 
     Cell[TextData[{Cell[TextData[ButtonBox["LicDongleLibraryPath", 
